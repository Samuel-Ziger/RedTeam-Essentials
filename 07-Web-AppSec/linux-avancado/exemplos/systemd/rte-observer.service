[Unit]
Description=RTE advanced Linux local observer
Documentation=https://docs.kernel.org/

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/rte-observer
DynamicUser=yes
StateDirectory=rte-observer
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
TasksMax=16
MemoryHigh=64M
MemoryMax=128M
CPUWeight=20
